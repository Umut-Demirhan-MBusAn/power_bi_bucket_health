{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git stash list:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)",
      "Bash(pbiviz --version:*)",
      "Bash(pbiviz info:*)",
      "Bash(pbiviz lint:*)",
      "Bash(pbiviz package:*)",
      "Bash(pbiviz start:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm add:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm run deploy:*)",
      "Bash(pbiviz install-cert:*)",
      "Bash(pbiviz mcp --init:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
