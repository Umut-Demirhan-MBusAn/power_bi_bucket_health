{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch -v:*)",
      "Bash(git branch -vv:*)",
      "Bash(git branch --merged:*)",
      "Bash(git branch --no-merged:*)",
      "Bash(git branch --contains:*)",
      "Bash(git branch -d *)",
      "Bash(git switch:*)",
      "Bash(git stash list:*)",
      "Bash(git worktree list)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:test)",
      "Bash(npm run eslint)",
      "Bash(npm run lint)",
      "Bash(npm run check:version)",
      "Bash(npm run validate:fixtures)",
      "Bash(npm run package)",
      "Bash(npm audit)",
      "Bash(npm audit --audit-level=moderate)",
      "Bash(pbiviz --version:*)",
      "Bash(pbiviz info:*)",
      "Bash(pbiviz lint:*)",
      "Bash(pbiviz package:*)",
      "Bash(gh run watch *)",
      "mcp__ccd_session__mark_chapter",
      "mcp__ccd_session__spawn_task",
      "mcp__ccd_session__dismiss_task",
      "mcp__ccd_session__read_widget_context",
      "mcp__visualize__read_me",
      "mcp__visualize__show_widget",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__preview_stop",
      "mcp__Claude_Browser__preview_list",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__tabs_context"
    ],
    "ask": [
      "Bash(git branch *-D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch *--force*)",
      "Bash(git branch *-M*)",
      "Bash(git branch *-C*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch *--force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch -C *)",
      "Bash(git switch * -C *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  },
  "enabledPlugins": {
    "legal@synced": false,
    "ip-legal@synced": false,
    "corporate-legal@synced": false,
    "product-legal@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "data@synced": false,
    "design@synced": false,
    "engineering@synced": false,
    "marketing@synced": false,
    "product-management@synced": false,
    "finance@synced": false,
    "marketing@knowledge-work-plugins": false,
    "product-management@knowledge-work-plugins": false,
    "sentry@claude-plugins-official": false,
    "auth0@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\" || exit 2"
          }
        ]
      }
    ]
  }
}
