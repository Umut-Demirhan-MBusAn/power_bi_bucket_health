{
  "name": "power-bi-bucket-health",
  "description": "Power BI custom visual for mining bucket GET component health.",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Umut-Demirhan-MBusAn/power_bi_bucket_health"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package",
    "lint": "pbiviz lint",
    "eslint": "eslint .",
    "build:test": "node -e \"require('fs').rmSync('.tmp/test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test test/unit/*.test.js",
    "test:coverage": "npm run build:test && node --test --experimental-test-coverage test/unit/*.test.js",
    "validate:fixtures": "pwsh -File scripts/validate-mock-data.ps1",
    "check:version": "node scripts/check-version.js"
  },
  "dependencies": {
    "powerbi-visuals-api": "~5.11.1",
    "powerbi-visuals-utils-formattingmodel": "^7.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3"
  }
}
